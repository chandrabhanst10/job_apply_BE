NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
APP_URL=http://localhost:4000
CLIENT_URL=http://localhost:3000
MONGO_URI=mongodb://mongo:27017/job_apply
REDIS_URL=redis://redis:6379
JWT_ACCESS_SECRET=replace-with-at-least-32-characters-access
JWT_REFRESH_SECRET=replace-with-at-least-32-characters-refresh
JWT_EMAIL_SECRET=replace-with-at-least-32-characters-email
JWT_PASSWORD_RESET_SECRET=replace-with-at-least-32-characters-reset
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_DOMAIN=
COOKIE_SECURE=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
